<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<NSLProjectTypes>UnitySupport;AnalyzerUtils;AnalyzerCore</NSLProjectTypes>

		<TargetFramework>netstandard2.0</TargetFramework>
		<Configurations>DebugExamples;Debug;Release;UnityDebug;Unity</Configurations>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>disable</Nullable>

		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>

		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IsRoslynComponent>true</IsRoslynComponent>

		<Version>$(VersionSuffix)</Version>
		<Authors>Relife87</Authors>
		<Description>NSL RPC Generator — source generator for interface-based RPC over NSL sockets</Description>

		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<PackageId>$(MSBuildProjectName)_Debug</PackageId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='UnityDebug'">
		<AssemblyName>Unity.$(MSBuildProjectName)</AssemblyName>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Unity'">
		<AssemblyName>Unity.$(MSBuildProjectName)</AssemblyName>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)'=='Debug' Or '$(Configuration)'=='Release' Or '$(Configuration)'=='DebugExamples'">
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='UnityDebug' Or '$(Configuration)'=='Unity'">
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\NSL.Generators.RpcGenerator.Shared\**\*.cs" Exclude="..\NSL.Generators.RpcGenerator.Shared\**\bin\**;..\NSL.Generators.RpcGenerator.Shared\**\obj\**">
		  <Link>NSL.Generators.RpcGenerator.Shared\%(RecursiveDir)%(FileName)%(Extension)</Link>
		</Compile>
		<Compile Remove="..\NSL.Generators.RpcGenerator.Shared\DefaultRPCNetworkChannel.cs" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\..\Core\NSL.SocketCore\**\*.cs" Exclude="..\..\..\Core\NSL.SocketCore\**\bin\**;..\..\..\Core\NSL.SocketCore\**\obj\**;..\..\..\Core\NSL.SocketCore\**\Network\**">
		  <Link>NSL.SocketCore\%(RecursiveDir)%(FileName)%(Extension)</Link>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\..\Core\Utils\NSL.Utils\**\*.cs" Exclude="..\..\..\Core\Utils\NSL.Utils\**\bin\**;..\..\..\Core\Utils\NSL.Utils\**\obj\**">
		  <Link>NSL.Utils\%(RecursiveDir)%(FileName)%(Extension)</Link>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\NSL.Generators.BinaryTypeIOGenerator\NSL.Generators.BinaryTypeIOGenerator.Shared\**\*.cs" Exclude="..\..\NSL.Generators.BinaryTypeIOGenerator\NSL.Generators.BinaryTypeIOGenerator.Shared\**\bin\**;..\..\NSL.Generators.BinaryTypeIOGenerator\NSL.Generators.BinaryTypeIOGenerator.Shared\**\obj\**">
		  <Link>NSL.Generators.BinaryTypeIOGenerator.Shared\%(RecursiveDir)%(FileName)%(Extension)</Link>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\NSL.Generators.BinaryGenerator\**\*.cs" Exclude="..\..\NSL.Generators.BinaryGenerator\**\bin\**;..\..\NSL.Generators.BinaryGenerator\**\obj\**">
		  <Link>NSL.Generators.BinaryGenerator\%(RecursiveDir)%(FileName)%(Extension)</Link>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\NSL.Generators.Utils\**\*.cs" Exclude="..\..\NSL.Generators.Utils\**\bin\**;..\..\NSL.Generators.Utils\**\obj\**">
		  <Link>NSL.Generators.Utils\%(RecursiveDir)%(FileName)%(Extension)</Link>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="..\..\..\Core\Utils\NSL.Utils\CommandLine\**" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="..\..\..\Core\Utils\NSL.Utils\IOUtils.cs" />
		<Compile Remove="..\..\..\Core\Utils\NSL.Utils\NSLConsoleOutput.cs" />
		<Compile Remove="..\..\..\Core\Utils\NSL.Utils\PermissionUtils.cs" />
		<Compile Remove="..\..\..\Core\Utils\NSL.Utils\Token.cs" />
	</ItemGroup>

</Project>
