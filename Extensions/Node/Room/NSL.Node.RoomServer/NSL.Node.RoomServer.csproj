<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<NSLProjectTypes>None</NSLProjectTypes>

		<TargetFramework>net10.0</TargetFramework>
		<Configurations>DebugExamples;Debug;Release</Configurations>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>disable</Nullable>

		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>

		<Version>$(VersionSuffix)</Version>
		<Authors>Relife87</Authors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<PackageId>$(MSBuildProjectName)_Debug</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\..\Base\NSL.Logger\NSL.Logger.csproj" />
		<ProjectReference Include="..\..\..\..\Core\NSL.SocketClient\NSL.SocketClient.csproj" />
		<ProjectReference Include="..\..\..\..\Protocols\LocalBridge\NSL.LocalBridge\NSL.LocalBridge.csproj" />
		<ProjectReference Include="..\..\..\..\Protocols\UDP\NSL.UDP.Client\NSL.UDP.Client.csproj" />
		<ProjectReference Include="..\..\..\..\ASPNET\WebSockets\NSL.WebSockets.Server.AspNetPoint\NSL.WebSockets.Server.AspNetPoint.csproj" />
		<ProjectReference Include="..\..\..\..\Protocols\WebSockets\NSL.WebSockets.Client\NSL.WebSockets.Client.csproj" />
		<ProjectReference Include="..\..\Bridge\NSL.Node.BridgeServer.Shared\NSL.Node.BridgeServer.Shared.csproj" />
		<ProjectReference Include="..\..\NSL.Node.Core\NSL.Node.Core.csproj" />
	</ItemGroup>

</Project>
